#!/usr/bin/env bash
# The noticeboard, as five commands any agent can run in a terminal.
#
# Board row 4601, Ric 31 October 2026 09:40. It exists because agents now run in two tools:
# Claude, where the board is reachable through the Supabase connector, and Codex, where it is
# not. A Codex agent has a psql connection string and nothing else, so the protocol in
# `CLAUDE.md` has to be runnable as commands rather than as SQL somebody retypes.
#
#   board read <label>      unread rows, plus the last 5 by BOTH twins of your role
#   board show <id>         the full body of one row
#   board post <label> "<subject>" <body-file>
#   board stamp <label> <id> [id ...]
#   board backlog [label]
#
# ============================================================================
# IT STAMPS `read_by`, NOT `read_at`, AND THAT IS A CORRECTION TO THE BRIEF
# ============================================================================
#
# Row 4601 asked for `read_at`. `read_at` was retired on 7 October 2026, rows 2761 and 2762,
# migration `20261008070000_the_board_remembers_who_has_read_a_row.sql`, because it was ONE
# timestamp shared by every agent: whichever agent stamped a row first HID IT from everybody
# else, and the rows most likely to be lost were the ones addressed to somebody else.
# `read_by` is per agent, which is the whole point of it. `CLAUDE.md` says plainly: do not
# filter on `read_at`.
#
# Built as briefed, every Codex agent's stamp would have done nothing and the unread filter
# would have returned the same rows for ever. So `read_by` is what moves here. `read_at` is set
# alongside it only as history, exactly as the migration left it.
#
# ============================================================================
# THE TWINS SHARE A LANE, SO THEY SHARE A FILTER
# ============================================================================
#
# `claude-donny` and `codex-donny` are one person in two tools. They never run at the same
# time, so whichever starts next has to see what the other was doing. `read` therefore filters
# out rows written by EITHER twin, and shows the last 5 by either, so a Codex session opens on
# the Claude session's last report rather than on a board that looks untouched.
#
# `stamp` writes BOTH of the lane's labels. THIS PARAGRAPH SAID THE OPPOSITE until 31 October
# 2026: it was written before Ric ruled the twin exception, and it survived the change, so the
# file's header contradicted its own `cmd_stamp` for as long as the file existed.
#
# Corrected here rather than quietly replaced, because this is the exact fault this repository
# keeps paying for: a stale line in a document that is read on trust. An agent believing the old
# wording would think its twin's read state was not being maintained, and the obvious response is
# a hand written `update` -- which is precisely what drifted the twins by forty seven rows on the
# morning they were levelled. The reasoning for the exception is written above `cmd_stamp`, next
# to the code that does it.
#
# ============================================================================
# CREDENTIALS
# ============================================================================
#
# HTTPS, which is what a Codex agent uses. Plain environment variables, not Codex "secrets":
# Codex strips secrets before the agent phase, so a secret would not be there to read.
#
#   RAAYDR_BOARD_ENDPOINT=https://<ref>.supabase.co/functions/v1/board
#   RAAYDR_BOARD_TOKEN=<token>        # OPTIONAL, see below
#
# `RAAYDR_BOARD_TOKEN` is optional on purpose. Codex can inject an `Authorization` header at
# its own proxy for an allowlisted host, so the agent never holds the token; with the variable
# unset this sends NO header and leaves that to the proxy. Measured both ways against a local
# stand-in: unset sends no header at all, set sends `Bearer <token>`.
#
# **In HTTPS mode nothing reads `.env.codex`, and neither database login is needed.** One
# allowlisted host is enough: the function reaches the backlog project from inside Supabase.
#
# Postgres, which is what a Claude side agent with a terminal uses. `.env.codex` at the
# repository root, gitignored, never committed and never on the board:
#
#   RAAYDR_BOARD_URL=postgresql://codex_board.<ref>:<password>@<pooler-host>:6543/postgres
#   RAAYDR_TRACKER_URL=postgresql://codex_tracker.<ref>:<password>@<pooler-host>:6543/postgres
#
# Both logins reach one table each and nothing else on their project, proven by refusal tests
# on board row 4603 rather than by reading the grant table.

set -euo pipefail

SUBJECT_MAX=140

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
envfile="$here/.env.codex"

die() { printf '%s\n' "board: $*" >&2; exit 1; }

if [ -f "$envfile" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$envfile"
  set +a
fi

# ============================================================================
# TWO TRANSPORTS, AND HTTPS IS THE ONE A CODEX AGENT CAN ACTUALLY USE
# ============================================================================
#
# Board rows 4614 and 4634. Codex agents run in OpenAI's cloud, where outbound traffic goes
# through an HTTP proxy, so a Postgres connection on 6543 does not survive. Claude side agents
# have a terminal and psql, and nothing about that needed changing.
#
# So: **set `RAAYDR_BOARD_ENDPOINT` and the script talks HTTPS to the `board` edge function.
# Leave it unset and it talks Postgres exactly as before.** Same five commands either way.
#
# THE ENDPOINT VARIABLE IS NOT `RAAYDR_BOARD_URL`, deliberately. That one is the Postgres
# connection string and the two would be a sentence apart in the same file, which is how
# somebody pastes one into the other. The names are different because the values are.
#
# `RAAYDR_BOARD_TOKEN` is optional even in HTTPS mode. Codex can inject an `Authorization`
# header at its proxy for an allowlisted host, so the agent never holds the token at all; with
# the variable unset this sends no header and lets that happen. With it set, it sends the
# header itself. Both work, and the second needs no feature anybody has to confirm first.
using_http() { [ -n "${RAAYDR_BOARD_ENDPOINT:-}" ]; }

need_psql() {
  command -v psql >/dev/null 2>&1 || die "psql is not installed. On a Mac: brew install libpq"
}

need_jq() {
  command -v jq >/dev/null 2>&1 || die "jq is not installed. On a Mac: brew install jq"
}

# The endpoint answers JSON and says what went wrong in `error`. A curl that cannot reach the
# host at all is a different failure from one the function refused, and they are told apart
# here so a reader is not left guessing which.
http_call() {
  local payload="$1" raw code body
  need_jq
  local -a auth=()
  [ -n "${RAAYDR_BOARD_TOKEN:-}" ] && auth=(-H "authorization: Bearer ${RAAYDR_BOARD_TOKEN}")
  raw="$(curl -sS --max-time 30 -X POST "$RAAYDR_BOARD_ENDPOINT" \
          -H 'content-type: application/json' "${auth[@]}" \
          --data "$payload" -w $'\n%{http_code}' 2>&1)" \
    || die "could not reach $RAAYDR_BOARD_ENDPOINT: $raw"
  code="${raw##*$'\n'}"
  body="${raw%$'\n'*}"
  case "$code" in
    200) printf '%s' "$body" ;;
    403) die "the endpoint refused the token (403). Check RAAYDR_BOARD_TOKEN, or let Codex inject the header." ;;
    503) die "the endpoint is not configured (503). Its BOARD_TOKEN secret is not set." ;;
    *)   die "the endpoint answered $code: $(printf '%s' "$body" | jq -r '.error // .' 2>/dev/null || printf '%s' "$body")" ;;
  esac
}

board_url() {
  need_psql
  [ -n "${RAAYDR_BOARD_URL:-}" ] || die "RAAYDR_BOARD_URL is not set. Put it in $envfile"
  printf '%s' "$RAAYDR_BOARD_URL"
}

tracker_url() {
  need_psql
  [ -n "${RAAYDR_TRACKER_URL:-}" ] || die "RAAYDR_TRACKER_URL is not set. Put it in $envfile"
  printf '%s' "$RAAYDR_TRACKER_URL"
}

# claude-donny and codex-donny are one lane. Given either, this prints both, so the filter and
# the recent list are about the ROLE rather than about which tool happens to be running.
#
# THE PAIRS ARE LISTED RATHER THAN DERIVED, because one of them is not derivable. The Claude
# label is `claude-code` and the Codex label row 4601 asks for is `codex-codey`, after what Ric
# calls that agent. Prefix arithmetic turns `codex-codey` into `claude-codey`, which is not a
# label anybody posts under, so the lane's whole history would read as somebody else's.
PAIRS="claude-code:codex-codey
claude-donny:codex-donny
claude-deuce:codex-deuce
claude-sonic:codex-sonic
claude-emma:codex-emma
claude-raph:codex-raph
claude-dez:codex-dez"

twins() {
  local label="$1" pair
  while IFS= read -r pair; do
    case "$label" in
      "${pair%%:*}"|"${pair##*:}") printf '%s %s' "${pair%%:*}" "${pair##*:}"; return 0 ;;
    esac
  done <<<"$PAIRS"
  die "unknown label '$label'. Known: $(printf '%s' "$PAIRS" | tr '\n' ' ' | tr ':' '/')"
}

usage() {
  cat <<'USAGE'
board read  <label>                      unread rows, then the last 5 by both twins
board show  <id>                         the full body of one row
board post  <label> "<subject>" <file>   subject is capped, checked before anything is sent
board stamp <label> <id> [id ...]        append BOTH of your lane's labels to read_by
board backlog [label]                    open work_items, highest priority first

  label is claude-<name> or codex-<name>, e.g. codex-donny
USAGE
}

cmd_read() {
  local label="${1:-}"; [ -n "$label" ] || die "board read <label>"
  read -r mine twin <<<"$(twins "$label")"

  if using_http; then
    local res
    res="$(http_call "$(jq -nc --arg l "$label" '{command:"read",label:$l}')")"
    printf '== unread, not written by %s or %s ==\n' "$mine" "$twin"
    printf '%s' "$res" | jq -r '.unread[] | "\(.id)  \(.created_at[5:16])  \(.author)  \(.subject)"'
    printf '\n== your lane last, both tools (read the body before you start) ==\n'
    printf '%s' "$res" | jq -r '.recent[] | "\(.id)  \(.created_at[5:16])  \(.author)  \(.subject)"'
    printf '\nFull body of a row:  board show <id>\n'
    return
  fi

  printf '== unread, not written by %s or %s ==\n' "$mine" "$twin"
  psql "$(board_url)" -v ON_ERROR_STOP=1 -v mine="$mine" -v twin="$twin" <<'SQL'
\pset format wrapped
\pset columns 110
select id,
       to_char(created_at at time zone 'UTC', 'DD Mon HH24:MI') as utc,
       author,
       subject,
       coalesce(related_ref, '') as ref
  from ops.handoff
 where author not in (:'mine', :'twin')
   and not (:'mine' = any (read_by))
 order by id;
SQL

  printf '\n== your lane last, both tools (read the body before you start) ==\n'
  psql "$(board_url)" -v ON_ERROR_STOP=1 -v mine="$mine" -v twin="$twin" <<'SQL'
\pset format wrapped
\pset columns 110
select id,
       to_char(created_at at time zone 'UTC', 'DD Mon HH24:MI') as utc,
       author,
       subject
  from (select * from ops.handoff
         where author in (:'mine', :'twin')
         order by id desc limit 5) recent
 order by id;
SQL

  printf '\nFull body of a row:  board show <id>\n'
}

cmd_show() {
  local id="${1:-}"; [ -n "$id" ] || die "board show <id>"
  if using_http; then
    http_call "$(jq -nc --argjson i "$id" '{command:"show",id:$i}')" \
      | jq -r '.row | "#\(.id)  \(.author)  \(.created_at)\n\(.subject)\n\(if .related_ref then "ref: " + .related_ref else "" end)\n\n\(.body)"'
    return
  fi
  psql "$(board_url)" -v ON_ERROR_STOP=1 -v id="$id" -tA <<'SQL'
select format(E'#%s  %s  %s\n%s\n%s\n\n%s',
              id, author, to_char(created_at at time zone 'UTC', 'DD Mon YYYY HH24:MI')||' UTC',
              subject, coalesce('ref: '||related_ref, ''), body)
  from ops.handoff where id = (:'id')::bigint;
SQL
}

# The subject is checked HERE, before a connection is opened. The table's own constraint rejects
# a long subject outright rather than truncating it, so the whole report would have to be re-sent;
# 4601 asked for 140 to leave room under that 200.
cmd_post() {
  local label="${1:-}" subject="${2:-}" file="${3:-}"
  [ -n "$label" ] && [ -n "$subject" ] && [ -n "$file" ] || die 'board post <label> "<subject>" <body-file>'
  twins "$label" >/dev/null
  [ -f "$file" ] || die "body file not found: $file"

  local len; len=${#subject}
  [ "$len" -le "$SUBJECT_MAX" ] || die "subject is $len characters, the cap is $SUBJECT_MAX. Nothing was sent. Write one line somebody can act on."
  [ -s "$file" ] || die "body file is empty: $file"

  local body; body="$(cat "$file")"
  if using_http; then
    http_call "$(jq -nc --arg l "$label" --arg s "$subject" --arg b "$body" --arg r "${4:-}" \
                   '{command:"post",label:$l,subject:$s,body:$b,related_ref:(if $r == "" then null else $r end)}')" \
      | jq -r '"posted row \(.posted.id)"'
    return
  fi
  psql "$(board_url)" -v ON_ERROR_STOP=1 -tA \
       -v label="$label" -v subject="$subject" -v body="$body" -v ref="${4:-}" <<'SQL'
insert into ops.handoff (author, subject, body, related_ref)
values (:'label', :'subject', :'body', nullif(:'ref', ''))
returning 'posted row '||id;
SQL
}

# Its own statement, never bundled with the insert. A write that rolls back takes everything in
# its transaction with it, and a stamp lost beside a successful post is a row that reads as
# waiting for somebody who has already answered it.
#
# IT STAMPS BOTH OF THE LANE'S LABELS, which is a deliberate exception to `CLAUDE.md`'s "never
# stamp a row on another agent's behalf", and Ric ruled it on 31 October.
#
# That rule exists so one agent cannot hide a row from a DIFFERENT agent: "a row addressed to two
# of you is read by two of you". The twins are not two agents. They are one lane in two tools,
# they never run at the same time, and row 4601 asks that whichever starts picks up where the
# other stopped. Stamping one label only would mean a lane re-reading its own finished work every
# time it changed tool, and the unread backlog regrowing from the day it was cleared.
cmd_stamp() {
  local label="${1:-}"; shift || true
  [ -n "$label" ] && [ "$#" -gt 0 ] || die "board stamp <label> <id> [id ...]"
  local mine twin; read -r mine twin <<<"$(twins "$label")"

  local ids; ids="$(printf '%s,' "$@")"; ids="${ids%,}"
  printf '%s' "$ids" | grep -Eq '^[0-9]+(,[0-9]+)*$' || die "ids must be numbers, got: $ids"

  if using_http; then
    http_call "$(jq -nc --arg l "$label" --argjson ids "[$ids]" '{command:"stamp",label:$l,ids:$ids}')" \
      | jq -r 'if (.stamped | length) == 0 then "nothing to stamp; already read" else (.stamped[] | "stamped \(.)") end'
    return
  fi

  psql "$(board_url)" -v ON_ERROR_STOP=1 -tA -v mine="$mine" -v twin="$twin" -v ids="$ids" <<'SQL'
update ops.handoff
   set read_by = (select array_agg(distinct l)
                    from unnest(read_by || (:'mine')::text || (:'twin')::text) as l),
       read_at = coalesce(read_at, now())
 where id = any (string_to_array(:'ids', ',')::bigint[])
   and not ((:'mine') = any (read_by) and (:'twin') = any (read_by))
returning 'stamped '||id;
SQL
}

cmd_backlog() {
  if using_http; then
    http_call '{"command":"backlog"}' \
      | jq -r '.rows[] | "\(.id)  p\(.priority)  \(.stream)  \(.owner // "-")  \(.status)  \(.title)"'
    return
  fi
  psql "$(tracker_url)" -v ON_ERROR_STOP=1 <<'SQL'
\pset format wrapped
\pset columns 110
select id, priority as p, stream, owner, status, title
  from public.work_items
 where status in ('open', 'progress', 'blocked')
 order by priority, id;
SQL
}

case "${1:-}" in
  read)    shift; cmd_read "$@" ;;
  show)    shift; cmd_show "$@" ;;
  post)    shift; cmd_post "$@" ;;
  stamp)   shift; cmd_stamp "$@" ;;
  backlog) shift; cmd_backlog "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
